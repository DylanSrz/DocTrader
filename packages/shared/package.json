{
  "name": "@doctrader/shared",
  "version": "0.0.0",
  "private": true,
  "description": "Tipos y reglas de negocio puras compartidas por la API y la web",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint src",
    "test": "vitest run"
  },
  "dependencies": {
    "@date-fns/tz": "^1.5.0",
    "date-fns": "^4.4.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "oxlint": "^1.58.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.2"
  }
}

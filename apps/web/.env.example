# Copia este archivo como .env.local para desarrollo.

# Dirección de la API (apps/api). Solo la usa el servidor de la web: el navegador nunca habla con la API.
API_URL=http://localhost:4000
# El mismo PROXY_SECRET de apps/api/.env (`openssl rand -base64 32`).
PROXY_SECRET=

# Cloudflare Turnstile: clave pública del sitio (opcional en desarrollo; sin ella no se muestra el desafío).
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Muestra /sistema (referencia del sistema de diseño) en el entorno de pruebas. Nunca en producción.
MOSTRAR_SISTEMA=false

# Errores del servidor de la web en Sentry (opcional).
# SENTRY_DSN=

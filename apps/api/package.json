{
  "name": "@doctrader/api",
  "version": "0.0.0",
  "private": true,
  "description": "API y worker de la plataforma DocTraderPRO (NestJS)",
  "type": "module",
  "scripts": {
    "build": "pnpm --filter @doctrader/shared build && nest build",
    "dev": "nest start --watch",
    "dev:worker": "nest start --watch --entryFile worker",
    "start": "node dist/main.js",
    "start:worker": "node dist/worker.js",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint src test",
    "test": "vitest run",
    "test:e2e": "vitest run --config ./vitest.config.e2e.ts",
    "migracion:aplicar": "nest build && node dist/database/migrar.js",
    "semilla": "nest build && node dist/database/semilla.js"
  },
  "dependencies": {
    "@doctrader/shared": "workspace:*",
    "@nestjs/bullmq": "^12.0.0",
    "@nestjs/common": "^12.2.0",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "^12.2.0",
    "@nestjs/platform-express": "^12.2.0",
    "@nestjs/typeorm": "^12.0.2",
    "@node-rs/argon2": "^2.2.2",
    "@sentry/node": "10.75.3",
    "aws4fetch": "1.0.20",
    "bullmq": "^6.4.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "helmet": "^8.3.0",
    "ioredis": "^5.11.1",
    "otpauth": "^9.5.2",
    "pg": "^8.23.1",
    "qrcode": "^1.5.4",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "sharp": "0.35.5",
    "typeorm": "^1.1.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.10",
    "@nestjs/schematics": "^12.0.10",
    "@nestjs/testing": "^12.2.0",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/qrcode": "^1.5.6",
    "@types/supertest": "^7.0.0",
    "oxlint": "^1.89.0",
    "supertest": "^7.1.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.2"
  }
}

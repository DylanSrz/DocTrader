{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "RAILPACK",
    "buildCommand": "pnpm install --frozen-lockfile && pnpm --filter @doctrader/shared build && pnpm --filter @doctrader/api build",
    "watchPatterns": ["apps/api/**", "packages/shared/**", "pnpm-lock.yaml"]
  },
  "deploy": {
    "startCommand": "node apps/api/dist/main.js",
    "preDeployCommand": ["node apps/api/dist/database/migrar.js"],
    "healthcheckPath": "/salud",
    "restartPolicyType": "ON_FAILURE"
  }
}

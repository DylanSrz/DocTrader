# Copia este archivo como .env para desarrollo. Nunca subas el .env al repositorio.
NODE_ENV=development
PORT=4000

# Servicios de docker/compose.yml
DATABASE_URL=postgres://doctrader:doctrader@localhost:5432/doctrader
DATABASE_SSL=false
REDIS_URL=redis://localhost:6379

# Origen de la web, para CORS
WEB_ORIGIN=http://localhost:3000

# Llave para la cadena de hashes de la auditoría (32 bytes en base64: `openssl rand -base64 32`)
AUDIT_HMAC_KEY=

# Cifrado por campo y huellas de búsqueda (cada una, 32 bytes en base64: `openssl rand -base64 32`).
# Guarda las de producción en el gestor de contraseñas: si se pierden, los datos cifrados no se recuperan.
DATA_ENCRYPTION_KEY=
LOOKUP_HMAC_KEY=

# Secreto compartido con la web (el mismo valor en apps/web/.env.local). En producción es obligatorio.
# `openssl rand -base64 32`
PROXY_SECRET=

# Cloudflare Turnstile (opcional en desarrollo; sin él no se pide el desafío)
# TURNSTILE_SECRET=

# Correos: Mailpit de docker/compose.yml en desarrollo; en producción, RESEND_API_KEY
MAILPIT_URL=http://localhost:8025
# RESEND_API_KEY=
# MAIL_FROM=DocTraderPRO <notificaciones@doctraderpro.com>
# MAIL_REPLY_TO=support@doctraderpro.com

# Precio de BTC: Binance sin llave y CoinGecko de respaldo (la llave del plan Demo es opcional)
# COINGECKO_API_KEY=

# Verificación de pagos en Tron (opcionales; sin llave funcionan con pocas consultas)
# TRONGRID_API_KEY=
# TRONSCAN_API_KEY=

# Revisar contraseñas filtradas en Have I Been Pwned (true o false)
HIBP_ACTIVO=true

# Huellas del control de la prueba (openssl rand -base64 32). Sin ella, las solicitudes de prueba quedan cerradas.
# TRIAL_HMAC_KEY=
# SMS con Twilio Verify. En desarrollo, sin estas variables, el código se escribe en el registro de la API.
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_VERIFY_SERVICE_SID=
# Adjuntos de soporte en Cloudflare R2 (privado). En desarrollo, sin estas variables, van a una carpeta local
# (ARCHIVOS_DIR, por defecto en la carpeta temporal) y se descargan por la API (API_PUBLIC_URL).
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=
# ARCHIVOS_DIR=
# API_PUBLIC_URL=http://localhost:4000

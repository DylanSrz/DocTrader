# Copia este archivo como .env para desarrollo. Nunca subas el .env al repositorio.
NODE_ENV=development
PORT=4000

# Servicios de docker/compose.yml
DATABASE_URL=postgres://doctrader:doctrader@localhost:5432/doctrader
DATABASE_SSL=false
REDIS_URL=redis://localhost:6379

# Origen de la web, para CORS
WEB_ORIGIN=http://localhost:3000

# Llave para la cadena de hashes de la auditoría (32 bytes en base64: `openssl rand -base64 32`)
AUDIT_HMAC_KEY=

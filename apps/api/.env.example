# Copia este archivo como .env para desarrollo. Nunca subas el .env al repositorio.
NODE_ENV=development
PORT=4000

# Servicios de docker/compose.yml
DATABASE_URL=postgres://doctrader:doctrader@localhost:5432/doctrader
DATABASE_SSL=false
REDIS_URL=redis://localhost:6379

# Origen de la web, para CORS
WEB_ORIGIN=http://localhost:3000

# Llave para la cadena de hashes de la auditoría (32 bytes en base64: `openssl rand -base64 32`)
AUDIT_HMAC_KEY=

# Cifrado por campo y huellas de búsqueda (cada una, 32 bytes en base64: `openssl rand -base64 32`).
# Guarda las de producción en el gestor de contraseñas: si se pierden, los datos cifrados no se recuperan.
DATA_ENCRYPTION_KEY=
LOOKUP_HMAC_KEY=

# Secreto compartido con la web (el mismo valor en apps/web/.env.local). En producción es obligatorio.
# `openssl rand -base64 32`
PROXY_SECRET=

# Cloudflare Turnstile (opcional en desarrollo; sin él no se pide el desafío)
# TURNSTILE_SECRET=

# Correos: Mailpit de docker/compose.yml en desarrollo; en producción, RESEND_API_KEY
MAILPIT_URL=http://localhost:8025
# RESEND_API_KEY=
# MAIL_FROM=DocTraderPRO <notificaciones@doctraderpro.com>
# MAIL_REPLY_TO=support@doctraderpro.com

# Revisar contraseñas filtradas en Have I Been Pwned (true o false)
HIBP_ACTIVO=true
